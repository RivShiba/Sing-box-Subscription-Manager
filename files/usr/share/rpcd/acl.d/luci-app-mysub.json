{
  "luci-app-mysub": {
    "description": "Grant UCI access for mysub",
    "read": {
      "uci": [ "mysub" ],
      "file": [ 
        "/var/log/mysub.log", 
        "/etc/mysub/*" 
      ]
    },
    "write": {
      "uci": [ "mysub" ],
      "file": [ 
        "/var/log/mysub.log", 
        "/tmp/mysub_links.txt", 
        "/tmp/mysub_outbounds.json", 
        "/tmp/mysub_config.json",
        "/etc/mysub/*"
      ]
    }
  }
}