config mysub 'main'
	option cron '0 4 * * *'
	option base_config '/etc/mysub/template.json'
	option output_config '/etc/mysub/mysub.json'
	option log_level 'info'
	option use_analysis_template '0'
	option max_delay_ms '500'
	option analysis_cron_enabled '0'
	option analysis_cron_time '03:30'
	list urls 'https://example.com/your-subscription-link-1'
	list urls 'https://example.com/your-subscription-link-2'